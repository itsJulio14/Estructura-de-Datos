import heapq

grafo = {
    'Root': [('0', 20), ('3', 20), ('4', 33)],
    '0': [('Root', 20), ('1', 10)],
    '1': [('0', 10), ('3', 50), ('4', 10)],
    '3': [('Root', 20), ('1', 50), ('4', 20), ('5', 2)],
    '4': [('Root', 33), ('1', 10), ('3', 20), ('5', 1)],
    '5': [('4', 1), ('3', 2)]
}

def prim(grafo, inicio):
    visitados = set()
    mst = []
    heap = [(0, inicio, None)]

    while heap:
        peso, nodo, padre = heapq.heappop(heap)

        if nodo in visitados:
            continue

        visitados.add(nodo)

        if padre is not None:
            mst.append((padre, nodo, peso))

        for vecino, costo in grafo[nodo]:
            if vecino not in visitados:
                heapq.heappush(heap, (costo, vecino, nodo))
    return mst

mst = prim(grafo, 'Root')

total = sum(peso for _, _, peso in mst)

print("Aristas del MST:")
for u, v, w in mst:
    print(f"{u} - {v} : {w}")

print("Peso total:", total)